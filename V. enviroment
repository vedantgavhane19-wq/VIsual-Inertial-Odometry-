Activate the PYNQ Environment in Root
sudo -i
source /etc/profile.d/pynq_venv.sh
cd /home/ubuntu/harris_demo
python3 -c "
from pynq import Overlay
ol = Overlay('harris_kv260.bit')
print('FPGA Programmed Successfully!')
print('Detected IP blocks:', list(ol.ip_dict.keys()))
"

Inspect IP Register Map
python3 -c "
from pynq import Overlay
ol = Overlay('harris_kv260.bit')
print(ol.corner_harris_accel_0.register_map)
"

sudo /usr/local/share/pynq-venv/bin/python3 -c "
from pynq import Overlay
ol = Overlay('harris_kv260.bit')
print(ol.axi_dma_0.register_map)
"
