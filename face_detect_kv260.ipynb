#!/usr/bin/env python3
"""How much work does the cascade really do per window?

Runs the golden model's cascade over the image pyramid and counts, for every stage,
how many windows ENTER it. From that it reports:
  - the fraction of windows that survive each stage
  - the average number of weak classifiers evaluated per window
  - rough cycles per window and per frame for a given loop II / per-window overhead

This is the number that sizes the hardware (e.g. is stage 0 really rejecting >80%?).

Usage:
  py stage_stats.py out\\cascade.json [image] [min_face]
    image     any photo (default: scikit-image astronaut). A webcam still is best.
    min_face  smallest face in pixels of the 320x240 frame (default 48, same as v2)
"""
import sys

import cv2
import numpy as np

import golden_model as gm


def stage_counts(img, c):
    """Number of windows entering each stage (same maths as gm.detect_level)."""
    W, H, Q = c["win_w"], c["win_h"], c["q"]
    h, w = img.shape
    ii, sq = gm.integral(img)
    ys, xs = np.mgrid[0:h - H + 1, 0:w - W + 1]
    ys, xs = ys.ravel(), xs.ravel()
    area = (W - 2) * (H - 2)
    s = gm.rect_sum(ii, ys, xs, 1, 1, W - 2, H - 2)
    s2 = gm.rect_sum(sq, ys, xs, 1, 1, W - 2, H - 2)
    var = s2 * area - s * s
    nf = np.sqrt(np.maximum(var, 1).astype(np.float64)) / area
    nf[var <= 0] = 1.0

    entering, k = [], 0
    for st in range(len(c["stage_nweak"])):
        entering.append(len(xs))
        if len(xs) == 0:
            entering += [0] * (len(c["stage_nweak"]) - st - 1)
            break
        stage_sum = np.zeros(len(xs), np.int64)
        for _ in range(c["stage_nweak"][st]):
            off, nr = c["weak_off"][k], c["weak_nrect"][k]
            f = np.zeros(len(xs), np.int64)
            for r in range(off, off + nr):
                f += c["rwt"][r] * gm.rect_sum(ii, ys, xs, c["rx"][r], c["ry"][r], c["rw"][r], c["rh"][r])
            lhs = f.astype(np.float64) / area * (1 << Q)
            stage_sum += np.where(lhs >= c["weak_thr"][k] * nf, c["weak_l1"][k], c["weak_l0"][k])
            k += 1
        alive = stage_sum >= c["stage_thr"][st]
        xs, ys, nf = xs[alive], ys[alive], nf[alive]
    return np.array(entering, dtype=np.int64), len(xs)     # entering[st], final survivors


def main():
    if len(sys.argv) < 2:
        raise SystemExit(__doc__)
    c = gm.load(sys.argv[1])
    if len(sys.argv) > 2 and sys.argv[2] != "-":
        img = cv2.imread(sys.argv[2], cv2.IMREAD_GRAYSCALE)
        if img is None:
            raise SystemExit(f"cannot read {sys.argv[2]}")
    else:
        from skimage import data
        img = cv2.cvtColor(data.astronaut(), cv2.COLOR_RGB2GRAY)
    img = cv2.resize(img, (320, 240), interpolation=cv2.INTER_AREA)
    img = cv2.equalizeHist(img)
    min_face = float(sys.argv[3]) if len(sys.argv) > 3 else 48.0

    W, H = c["win_w"], c["win_h"]
    n_st = len(c["stage_nweak"])
    total = np.zeros(n_st, np.int64)
    s = 1.0
    while s * W < min_face:
        s *= 1.2
    n_levels = 0
    while img.shape[0] / s >= H and img.shape[1] / s >= W:
        lvl = cv2.resize(img, (int(round(320 / s)), int(round(240 / s))), interpolation=cv2.INTER_LINEAR)
        e, _ = stage_counts(lvl, c)
        total += e
        n_levels += 1
        s *= 1.2

    n_win = int(total[0])
    weaks = np.array(c["stage_nweak"], dtype=np.int64)
    work = int((total * weaks).sum())
    print(f"{n_levels} pyramid levels, {n_win} windows per frame (min_face={min_face:g})\n")
    print("stage  weaks   windows entering   survive (of all)   rejected at this stage")
    for st in range(min(n_st, 12)):
        nxt = total[st + 1] if st + 1 < n_st else 0
        rej = 100.0 * (total[st] - nxt) / max(total[st], 1)
        print(f"{st:5d} {weaks[st]:6d} {total[st]:18d} {100.0 * total[st] / n_win:16.1f}% {rej:18.1f}%")
    if n_st > 12:
        print(f"  ... {n_st - 12} more stages, {int(total[12:].sum())} window-entries")

    avg_weaks = work / n_win
    print(f"\naverage weak classifiers evaluated per window: {avg_weaks:.1f}")
    print(f"share of ALL windows rejected by stage 0: {100.0 * (n_win - total[1]) / n_win:.1f}%")
    print(f"share rejected by the end of stage 2     : {100.0 * (n_win - total[3]) / n_win:.1f}%\n")
    print("cycles per frame (hardware only, 100 MHz) if windows are processed one at a time:")
    for ii_loop in (1, 6, 12):
        for overhead in (20, 60):
            cyc = avg_weaks * ii_loop + overhead
            print(f"  loop II={ii_loop:2d}, {overhead:2d} cycles/window overhead -> {cyc:6.0f} cycles/window"
                  f" -> {n_win * cyc / 1e5:7.1f} ms/frame ({1000.0 / max(n_win * cyc / 1e5, 1e-9):5.1f} fps max)")


if __name__ == "__main__":
    main()
