import time
import cv2
import numpy as np
import ipywidgets as widgets
from IPython.display import display
from pynq import MMIO, Overlay, allocate

# -------------------------------------------------------------------------
# 1. Hardware, Overlay & Memory Allocations
# -------------------------------------------------------------------------
BIT_FILE  = "face_detect.bit"
CTRL_BASE = 0xA0000000

MAX_W, MAX_H, MAX_HITS = 320, 240, 4096
WIN = 24

REG_CTRL                   = 0x00
REG_RET                    = 0x10
REG_FRAME_LO, REG_FRAME_HI = 0x18, 0x1C
REG_HITS_LO,  REG_HITS_HI  = 0x24, 0x28
REG_WIDTH,    REG_HEIGHT   = 0x30, 0x38

ol = Overlay(BIT_FILE)
ip = MMIO(CTRL_BASE, 0x10000)

frame_buf = allocate(shape=(MAX_W * MAX_H,), dtype=np.uint8)
hits_buf  = allocate(shape=(MAX_HITS,),       dtype=np.uint32)

# -------------------------------------------------------------------------
# 2. Hardware Driver & Clustering Helpers
# -------------------------------------------------------------------------
def run_kernel(img, timeout_s=1.0):
    h, w = img.shape
    if not img.flags['C_CONTIGUOUS']:
        img = np.ascontiguousarray(img)

    frame_buf[: w * h] = img.ravel()
    frame_buf.sync_to_device()

    fa = int(frame_buf.device_address)
    ha = int(hits_buf.device_address)
    ip.write(REG_FRAME_LO, fa & 0xFFFFFFFF)
    ip.write(REG_FRAME_HI, (fa >> 32) & 0xFFFFFFFF)
    ip.write(REG_HITS_LO,  ha & 0xFFFFFFFF)
    ip.write(REG_HITS_HI,  (ha >> 32) & 0xFFFFFFFF)
    ip.write(REG_WIDTH,    w)
    ip.write(REG_HEIGHT,   h)

    ip.write(REG_CTRL, 0x1)

    t0 = time.time()
    while not (ip.read(REG_CTRL) & 0x2):
        if time.time() - t0 > timeout_s:
            return np.array([], dtype=int), np.array([], dtype=int), 0

    n = ip.read(REG_RET)
    hits_buf.sync_from_device()

    k = min(n, MAX_HITS)
    if k == 0:
        return np.array([], dtype=int), np.array([], dtype=int), 0

    v = np.array(hits_buf[:k], dtype=np.uint32)
    return (v & 0xFFFF).astype(int), (v >> 16).astype(int), n


def group_rects(boxes, min_neighbors=4, eps=0.25):
    """Clusters boxes and rejects false alarms with min_neighbors >= 4."""
    n = len(boxes)
    if n == 0:
        return []
    parent = list(range(n))

    def find(i):
        while parent[i] != i:
            parent[i] = parent[parent[i]]
            i = parent[i]
        return i

    def similar(a, b):
        d = eps * (min(a[2], b[2]) + min(a[3], b[3])) * 0.5
        return (abs(a[0] - b[0]) <= d and abs(a[1] - b[1]) <= d
                and abs(a[0] + a[2] - b[0] - b[2]) <= d
                and abs(a[1] + a[3] - b[1] - b[3]) <= d)

    for i in range(n):
        for j in range(i + 1, n):
            if similar(boxes[i], boxes[j]):
                parent[find(i)] = find(j)

    clusters = {}
    for i in range(n):
        clusters.setdefault(find(i), []).append(boxes[i])

    out = []
    for members in clusters.values():
        if len(members) >= min_neighbors:
            m = np.mean(np.array(members, dtype=np.float64), axis=0)
            out.append(tuple(int(round(x)) for x in m))
    return out


# 4 focused pyramid scales for human faces
SCALES = [
    (213, 160, 640.0 / 213.0),  # Background face (~72px)
    (153, 115, 640.0 / 153.0),  # Mid-distance face (~100px)
    (113, 85,  640.0 / 113.0),  # Foreground desk face (~136px)
    (85,  64,  640.0 / 85.0)    # Close-up face (~180px)
]

def detect_faces_webcam(gray_frame):
    boxes = []
    for nw, nh, s_factor in SCALES:
        lvl = cv2.resize(gray_frame, (nw, nh), interpolation=cv2.INTER_NEAREST)
        xs, ys, count = run_kernel(lvl)
        box_dim = int(round(WIN * s_factor))

        for x, y in zip(xs, ys):
            boxes.append([
                int(round(x * s_factor)),
                int(round(y * s_factor)),
                box_dim,
                box_dim
            ])

    # Reject isolated false positives on chairs/tables
    return group_rects(boxes, min_neighbors=4)


# -------------------------------------------------------------------------
# 3. Multi-Person Spatial Box Tracker (Filters Ghost Boxes)
# -------------------------------------------------------------------------
class MultiFaceTracker:
    def __init__(self, max_missed=3, match_dist=85.0):
        self.tracks = []
        self.max_missed = max_missed
        self.match_dist = match_dist

    def update(self, detected_boxes):
        updated_tracks = []
        unmatched_detections = list(detected_boxes)

        for trk in self.tracks:
            tx, ty, tw, th = trk['box']
            tcx, tcy = tx + tw / 2.0, ty + th / 2.0

            best_idx = -1
            best_dist = float('inf')

            for idx, det in enumerate(unmatched_detections):
                dx, dy, dw, dh = det
                dcx, dcy = dx + dw / 2.0, dy + dh / 2.0
                dist = np.hypot(tcx - dcx, tcy - dcy)

                if dist < best_dist and dist < self.match_dist:
                    best_dist = dist
                    best_idx = idx

            if best_idx != -1:
                det = unmatched_detections.pop(best_idx)
                new_box = [trk['box'][i] * 0.65 + det[i] * 0.35 for i in range(4)]
                trk['box'] = new_box
                trk['hits'] += 1
                trk['missed'] = 0
                updated_tracks.append(trk)
            else:
                trk['missed'] += 1
                if trk['missed'] <= self.max_missed:
                    updated_tracks.append(trk)

        # Candidate tracks must be seen in at least 2 detection passes to be confirmed
        for det in unmatched_detections:
            updated_tracks.append({
                'box': [float(v) for v in det],
                'hits': 1,
                'missed': 0
            })

        self.tracks = updated_tracks

    def get_confirmed_boxes(self):
        # Only render boxes that have been verified at least twice
        return [
            [int(round(v)) for v in trk['box']]
            for trk in self.tracks
            if trk['hits'] >= 2
        ]


# -------------------------------------------------------------------------
# 4. Live Webcam Stream Loop (Locked at 15.0 FPS True Rate)
# -------------------------------------------------------------------------
CAM_INDEX = 0
cap = None

try:
    cap = cv2.VideoCapture(CAM_INDEX)
    cap.set(cv2.CAP_PROP_FRAME_WIDTH, 640)
    cap.set(cv2.CAP_PROP_FRAME_HEIGHT, 480)
    cap.set(cv2.CAP_PROP_BUFFERSIZE, 1)

    if not cap.isOpened():
        raise RuntimeError(f"Cannot access camera on /dev/video{CAM_INDEX}")

    for _ in range(5):
        cap.read()

    image_widget = widgets.Image(format='jpeg', width=640, height=480)
    display(image_widget)

    tracker = MultiFaceTracker(max_missed=3, match_dist=85.0)

    # Frame Pacing: Lock precisely at 15.0 FPS
    TARGET_FPS = 15.0
    FRAME_BUDGET = 1.0 / TARGET_FPS  # 66.7 ms

    # True Rolling 1-Second Counter
    fps_display = 15.0
    fps_timer = time.time()
    frames_counted = 0
    frame_idx = 0

    print(f"System Running. True FPS locked to {TARGET_FPS}. Ghost box filter active.")

    while True:
        t_frame_start = time.time()

        ret, frame = cap.read()
        if not ret or frame is None:
            break

        frame_idx += 1
        frames_counted += 1

        # Run detection on even frames
        if frame_idx % 2 == 0:
            gray = cv2.cvtColor(frame, cv2.COLOR_BGR2GRAY)
            detections = detect_faces_webcam(gray)
            tracker.update(detections)

        # Get only confirmed human face tracks
        confirmed_boxes = tracker.get_confirmed_boxes()
        for (bx, by, bw, bh) in confirmed_boxes:
            cv2.rectangle(frame, (bx, by), (bx + bw, by + bh), (0, 255, 0), 2)

        # True FPS calculation over actual elapsed 1.0-second interval
        t_now = time.time()
        elapsed_sec = t_now - fps_timer
        if elapsed_sec >= 1.0:
            fps_display = frames_counted / elapsed_sec
            frames_counted = 0
            fps_timer = t_now

        cv2.putText(frame, f"FPS: {fps_display:.1f} | Faces: {len(confirmed_boxes)}",
                    (20, 35), cv2.FONT_HERSHEY_SIMPLEX, 0.8, (0, 255, 0), 2)

        _, jpeg = cv2.imencode('.jpg', frame, [cv2.IMWRITE_JPEG_QUALITY, 55])
        image_widget.value = jpeg.tobytes()

        # Strict Frame Pacer (Prevents odd frames from rushing to 45+ FPS)
        t_work_done = time.time()
        work_time = t_work_done - t_frame_start
        sleep_needed = FRAME_BUDGET - work_time
        if sleep_needed > 0:
            time.sleep(sleep_needed)

except KeyboardInterrupt:
    print("Stream stopped.")
finally:
    if cap is not None and cap.isOpened():
        cap.release()
    frame_buf.freebuffer()
    hits_buf.freebuffer()
