# ============================================================================
# KV260 face detection - ONE cell (v2: faster + diagnostics)
# Needs next to this notebook: face_detect.bit, face_detect.hwh, tb_data/
# ============================================================================
RUN_SELFTEST = True      # compare hardware against the golden-model test data
WEBCAM_MODE  = "still"   # "still" = one frame + debug view, "live" = loop, None = off
CAM_INDEX    = 0         # check with:  ls /dev/video*
MAX_FRAMES   = 300       # live mode length (Kernel > Interrupt also stops it)

MIN_FACE      = 48       # smallest face to look for, in pixels of the 320x240 frame
                         # (bigger = faster: small-face pyramid levels are skipped)
MIN_NEIGHBORS = 3        # overlapping hits needed to accept a face (lower = more sensitive)
SCALE         = 1.2      # pyramid step
EQUALIZE      = True     # histogram equalisation, helps a lot on webcam images
# ============================================================================

# ---- 1. Load the bitstream and set up the accelerator ----------------------
import time
import numpy as np
import cv2
from pynq import Overlay, allocate, MMIO
from IPython.display import display, Image

BIT_FILE  = "face_detect.bit"     # face_detect.hwh must be next to it
CTRL_BASE = 0xA0000000            # s_axi_control base address (Address Editor / .hwh)

# Must match hls/face_detect.h
MAX_W, MAX_H, MAX_HITS = 320, 240, 4096
WIN = 24                          # Haar window size

# Register offsets, taken from design_1.hwh
REG_CTRL                   = 0x00   # bit0 ap_start, bit1 ap_done, bit2 ap_idle
REG_RET                    = 0x10   # number of hits
REG_FRAME_LO, REG_FRAME_HI = 0x18, 0x1C
REG_HITS_LO,  REG_HITS_HI  = 0x24, 0x28
REG_WIDTH,    REG_HEIGHT   = 0x30, 0x38

ol = Overlay(BIT_FILE)            # downloads the bitstream to the PL
ip = MMIO(CTRL_BASE, 0x10000)

frame_buf = allocate(shape=(MAX_W * MAX_H,), dtype=np.uint8)    # input frame in DDR
hits_buf  = allocate(shape=(MAX_HITS,),      dtype=np.uint32)   # output hits in DDR

print("bitstream loaded; accelerator idle:", bool(ip.read(REG_CTRL) & 0x4))


# ---- 2. Helpers: run the kernel, image pyramid, box grouping --------------
def run_kernel(img, timeout_s=5.0):
    """Run the accelerator on one 8-bit grayscale image (<= 320x240).
    Returns (xs, ys, n_total) - top-left corners of every 24x24 window that passed."""
    h, w = img.shape
    assert img.dtype == np.uint8 and w <= MAX_W and h <= MAX_H, "need uint8 image <= 320x240"

    frame_buf[: w * h] = img.ravel()
    frame_buf.flush()

    fa, ha = int(frame_buf.device_address), int(hits_buf.device_address)
    ip.write(REG_FRAME_LO, fa & 0xFFFFFFFF); ip.write(REG_FRAME_HI, fa >> 32)
    ip.write(REG_HITS_LO,  ha & 0xFFFFFFFF); ip.write(REG_HITS_HI,  ha >> 32)
    ip.write(REG_WIDTH,  w)
    ip.write(REG_HEIGHT, h)

    ip.write(REG_CTRL, 0x1)                      # ap_start
    t0 = time.time()
    while True:
        if ip.read(REG_CTRL) & 0x2:              # ap_done (clears when read)
            break
        if time.time() - t0 > timeout_s:
            raise TimeoutError("accelerator did not finish")

    n = ip.read(REG_RET)
    hits_buf.invalidate()
    k = min(n, MAX_HITS)
    v = np.array(hits_buf[:k], dtype=np.uint32)
    return (v & 0xFFFF).astype(int), (v >> 16).astype(int), n


def group_rects(boxes, min_neighbors=3, eps=0.2, max_boxes=2000):
    """Merge overlapping detections (numpy version, fast even with many hits).
    Keeps clusters with more than min_neighbors boxes, returns their average box."""
    n = len(boxes)
    if n <= min_neighbors:
        return []
    B = np.asarray(boxes, dtype=np.float64)
    if n > max_boxes:                                    # safety cap on pathological frames
        B = B[np.random.default_rng(0).choice(n, max_boxes, replace=False)]
        n = max_boxes
    x, y, w, h = B.T
    d = eps * (np.minimum(w[:, None], w[None, :]) + np.minimum(h[:, None], h[None, :])) * 0.5
    sim = ((np.abs(x[:, None] - x[None, :]) <= d)
           & (np.abs(y[:, None] - y[None, :]) <= d)
           & (np.abs((x + w)[:, None] - (x + w)[None, :]) <= d)
           & (np.abs((y + h)[:, None] - (y + h)[None, :]) <= d))
    labels = np.arange(n)                                # connected components by label spreading
    while True:
        nxt = np.where(sim, labels[None, :], n).min(axis=1)
        nxt = nxt[nxt]
        if np.array_equal(nxt, labels):
            break
        labels = nxt
    out = []
    ids, counts = np.unique(labels, return_counts=True)
    for lab, cnt in zip(ids, counts):
        if cnt > min_neighbors:
            m = B[labels == lab].mean(axis=0)
            out.append(tuple(int(round(v)) for v in m))
    return out


LAST = {}      # details of the most recent detect_faces() call, for diagnostics

def detect_faces(gray, scale=SCALE, min_neighbors=MIN_NEIGHBORS, min_face=MIN_FACE):
    """gray: uint8 image <= 320x240. Returns face boxes (x, y, w, h) in that image's pixels."""
    boxes, levels, t_hw = [], [], 0.0
    s = 1.0
    while s * WIN < min_face:            # these levels could only find faces smaller than min_face
        s *= scale
    while gray.shape[0] / s >= WIN and gray.shape[1] / s >= WIN:
        nh, nw = int(round(gray.shape[0] / s)), int(round(gray.shape[1] / s))
        lvl = cv2.resize(gray, (nw, nh), interpolation=cv2.INTER_LINEAR)
        t0 = time.time()
        xs, ys, n = run_kernel(lvl)
        t_hw += time.time() - t0
        if n > MAX_HITS:
            print(f"warning: {n} hits on a {nw}x{nh} level, only {MAX_HITS} kept")
        levels.append((nw, nh, int(n)))
        for x, y in zip(xs, ys):
            boxes.append([int(x * s), int(y * s), int(WIN * s), int(WIN * s)])
        s *= scale
    t0 = time.time()
    faces = group_rects(boxes, min_neighbors)
    LAST.update(raw=boxes, levels=levels, t_hw=t_hw, t_group=time.time() - t0)
    return faces


# ---- 3. Hardware self-test: accelerator vs the Python golden model ----------
if RUN_SELFTEST:
    import os
    DATA_DIR = "tb_data"

    bad = 0
    with open(os.path.join(DATA_DIR, "manifest.txt")) as f:
        levels = [line.split() for line in f if line.strip()]

    for k, (img_name, exp_name) in enumerate(levels):
        img = cv2.imread(os.path.join(DATA_DIR, img_name), cv2.IMREAD_GRAYSCALE)
        expected = set()
        with open(os.path.join(DATA_DIR, exp_name)) as f:
            for line in f:
                x, y = line.split()
                expected.add((int(x), int(y)))

        t0 = time.time()
        xs, ys, n = run_kernel(img)
        dt = (time.time() - t0) * 1000
        got = set(zip(xs.tolist(), ys.tolist()))

        missing, extra = len(expected - got), len(got - expected)
        ok = (missing + extra) <= 2          # same tolerance as the C testbench
        bad += (not ok)
        print(f"level {k:02d} {img.shape[1]:3d}x{img.shape[0]:3d}  expected={len(expected):4d} "
              f"hw={len(got):4d} missing={missing} extra={extra}  {dt:6.1f} ms  {'ok' if ok else 'MISMATCH'}")

    print("PASS: hardware matches the golden model" if bad == 0 else f"FAIL: {bad} level(s) differ")


# ---- 4. Webcam ----------------------------------------------------------------
def open_camera():
    cap = cv2.VideoCapture(CAM_INDEX)
    cap.set(cv2.CAP_PROP_FOURCC, cv2.VideoWriter_fourcc(*"MJPG"))  # many USB cams only reach 30 fps in MJPG
    cap.set(cv2.CAP_PROP_FRAME_WIDTH, 640)
    cap.set(cv2.CAP_PROP_FRAME_HEIGHT, 480)
    cap.set(cv2.CAP_PROP_BUFFERSIZE, 1)                            # avoid stale, queued-up frames
    print(f"camera opened: {int(cap.get(cv2.CAP_PROP_FRAME_WIDTH))}x{int(cap.get(cv2.CAP_PROP_FRAME_HEIGHT))}, "
          f"driver reports {cap.get(cv2.CAP_PROP_FPS):.0f} fps")
    for _ in range(5):                                             # let auto-exposure settle
        cap.read()
    return cap


def process(frame):
    """colour frame -> (processed 320x240 gray, face boxes, prep time)."""
    t0 = time.time()
    gray = cv2.cvtColor(frame, cv2.COLOR_BGR2GRAY)
    small = cv2.resize(gray, (MAX_W, MAX_H), interpolation=cv2.INTER_AREA)
    if EQUALIZE:
        small = cv2.equalizeHist(small)
    small = np.ascontiguousarray(small)
    t_prep = time.time() - t0
    return small, detect_faces(small), t_prep


def draw(frame, boxes):
    sx, sy = frame.shape[1] / MAX_W, frame.shape[0] / MAX_H
    for (x, y, w, h) in boxes:
        cv2.rectangle(frame, (int(x * sx), int(y * sy)),
                      (int((x + w) * sx), int((y + h) * sy)), (0, 255, 0), 2)
    return frame


_handle = [None]
def show(img, quality=75):
    """Update one image in place (no flicker) instead of clearing the output every frame."""
    ok, jpg = cv2.imencode(".jpg", img, [cv2.IMWRITE_JPEG_QUALITY, quality])
    im = Image(data=jpg.tobytes())
    if _handle[0] is None:
        _handle[0] = display(im, display_id=True)
    else:
        _handle[0].update(im)


if WEBCAM_MODE == "still":
    cap = open_camera()
    try:
        ok, frame = cap.read()
        if not ok:
            raise RuntimeError("could not read from the camera (check CAM_INDEX)")
        small, boxes, _ = process(frame)
    finally:
        cap.release()

    print("pyramid levels run on the hardware  (size: raw hits):")
    print("  " + ",  ".join(f"{w}x{h}: {n}" for w, h, n in LAST["levels"]))
    print(f"raw hits total: {len(LAST['raw'])}    accepted faces: {len(boxes)}  {boxes}")
    print(f"hardware time {LAST['t_hw'] * 1000:.0f} ms, grouping {LAST['t_group'] * 1000:.0f} ms")

    left = draw(frame.copy(), boxes)                                  # green = accepted faces
    right = cv2.cvtColor(cv2.resize(small, (640, 480), interpolation=cv2.INTER_NEAREST), cv2.COLOR_GRAY2BGR)
    for (x, y, w, h) in LAST["raw"][:400]:                            # blue = every raw hardware hit
        cv2.rectangle(right, (2 * x, 2 * y), (2 * (x + w), 2 * (y + h)), (255, 128, 0), 1)
    _handle[0] = None
    show(np.hstack([left, right]))            # left: result   right: what the hardware saw + raw hits

elif WEBCAM_MODE == "live":
    cap = open_camera()
    _handle[0] = None
    stats_h = display({"text/plain": "starting..."}, raw=True, display_id=True)
    acc = dict(camera=0.0, prep=0.0, hardware=0.0, group=0.0, show=0.0)
    n_done, t_start = 0, time.time()
    try:
        while n_done < MAX_FRAMES:
            t0 = time.time()
            ok, frame = cap.read()
            acc["camera"] += time.time() - t0
            if not ok:
                raise RuntimeError("could not read from the camera")
            small, boxes, t_prep = process(frame)
            acc["prep"] += t_prep
            acc["hardware"] += LAST["t_hw"]
            acc["group"] += LAST["t_group"]
            t0 = time.time()
            show(draw(frame, boxes))
            acc["show"] += time.time() - t0
            n_done += 1
            if n_done % 5 == 0:
                fps = n_done / (time.time() - t_start)
                ms = "  ".join(f"{k} {1000 * v / n_done:.0f}" for k, v in acc.items())
                stats_h.update({"text/plain": f"frame {n_done}   faces {len(boxes)}   raw hits {len(LAST['raw'])}   "
                                              f"{fps:.1f} fps\nms per frame:  {ms}"}, raw=True)
    except KeyboardInterrupt:
        print("stopped")
    finally:
        cap.release()
