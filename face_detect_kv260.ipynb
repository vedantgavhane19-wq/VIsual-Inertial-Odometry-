import time
import cv2
import numpy as np
import ipywidgets as widgets
from IPython.display import display
from pynq import MMIO, Overlay, allocate

# -------------------------------------------------------------------------
# 1. Hardware Initialization & Memory Buffers
# -------------------------------------------------------------------------
BIT_FILE  = "face_detect.bit"
CTRL_BASE = 0xA0000000

MAX_W, MAX_H, MAX_HITS = 320, 240, 4096
WIN = 24

REG_CTRL                   = 0x00
REG_RET                    = 0x10
REG_FRAME_LO, REG_FRAME_HI = 0x18, 0x1C
REG_HITS_LO,  REG_HITS_HI  = 0x24, 0x28
REG_WIDTH,    REG_HEIGHT   = 0x30, 0x38

ol = Overlay(BIT_FILE)
ip = MMIO(CTRL_BASE, 0x10000)

frame_buf = allocate(shape=(MAX_W * MAX_H,), dtype=np.uint8)
hits_buf  = allocate(shape=(MAX_HITS,),       dtype=np.uint32)

# -------------------------------------------------------------------------
# 2. Hardware Driver & Clustering Helpers
# -------------------------------------------------------------------------
def run_kernel(img, timeout_s=1.0):
    h, w = img.shape
    if not img.flags['C_CONTIGUOUS']:
        img = np.ascontiguousarray(img)

    frame_buf[: w * h] = img.ravel()
    frame_buf.sync_to_device()

    fa = int(frame_buf.device_address)
    ha = int(hits_buf.device_address)
    ip.write(REG_FRAME_LO, fa & 0xFFFFFFFF)
    ip.write(REG_FRAME_HI, (fa >> 32) & 0xFFFFFFFF)
    ip.write(REG_HITS_LO,  ha & 0xFFFFFFFF)
    ip.write(REG_HITS_HI,  (ha >> 32) & 0xFFFFFFFF)
    ip.write(REG_WIDTH,    w)
    ip.write(REG_HEIGHT,   h)

    ip.write(REG_CTRL, 0x1)

    t0 = time.time()
    while not (ip.read(REG_CTRL) & 0x2):
        if time.time() - t0 > timeout_s:
            return np.array([], dtype=int), np.array([], dtype=int), 0

    n = ip.read(REG_RET)
    hits_buf.sync_from_device()

    k = min(n, MAX_HITS)
    if k == 0:
        return np.array([], dtype=int), np.array([], dtype=int), 0

    v = np.array(hits_buf[:k], dtype=np.uint32)
    return (v & 0xFFFF).astype(int), (v >> 16).astype(int), n


def group_rects(boxes, min_neighbors=2, eps=0.3):
    n = len(boxes)
    if n == 0:
        return []
    parent = list(range(n))

    def find(i):
        while parent[i] != i:
            parent[i] = parent[parent[i]]
            i = parent[i]
        return i

    def similar(a, b):
        d = eps * (min(a[2], b[2]) + min(a[3], b[3])) * 0.5
        return (abs(a[0] - b[0]) <= d and abs(a[1] - b[1]) <= d
                and abs(a[0] + a[2] - b[0] - b[2]) <= d
                and abs(a[1] + a[3] - b[1] - b[3]) <= d)

    for i in range(n):
        for j in range(i + 1, n):
            if similar(boxes[i], boxes[j]):
                parent[find(i)] = find(j)

    clusters = {}
    for i in range(n):
        clusters.setdefault(find(i), []).append(boxes[i])

    out = []
    for members in clusters.values():
        if len(members) >= min_neighbors:
            m = np.mean(np.array(members, dtype=np.float64), axis=0)
            out.append(tuple(int(round(x)) for x in m))
    return out


# 4 multi-scale passes covering foreground (sitting) and background (standing) faces
SCALES = [
    (213, 160, 640.0 / 213.0),  # Background faces (~72px)
    (153, 115, 640.0 / 153.0),  # Mid-distance faces (~100px)
    (113, 85,  640.0 / 113.0),  # Foreground desk faces (~136px)
    (85,  64,  640.0 / 85.0)    # Close-up desk faces (~180px)
]

def detect_faces_webcam(gray_frame, min_neighbors=2):
    boxes = []
    for nw, nh, s_factor in SCALES:
        # Fast nearest-neighbor downscaling saves ARM CPU cycles
        lvl = cv2.resize(gray_frame, (nw, nh), interpolation=cv2.INTER_NEAREST)
        xs, ys, count = run_kernel(lvl)
        box_dim = int(round(WIN * s_factor))

        for x, y in zip(xs, ys):
            boxes.append([
                int(round(x * s_factor)),
                int(round(y * s_factor)),
                box_dim,
                box_dim
            ])

    return group_rects(boxes, min_neighbors=min_neighbors)


# -------------------------------------------------------------------------
# 3. Multi-Person Spatial Box Tracker
# -------------------------------------------------------------------------
class MultiFaceTracker:
    def __init__(self, max_missed=5, match_dist=90.0):
        self.tracks = []       # list of dicts: {'box': [x,y,w,h], 'missed': 0}
        self.max_missed = max_missed
        self.match_dist = match_dist

    def update(self, detected_boxes):
        updated_tracks = []
        unmatched_detections = list(detected_boxes)

        for trk in self.tracks:
            tx, ty, tw, th = trk['box']
            tcx, tcy = tx + tw / 2.0, ty + th / 2.0

            best_idx = -1
            best_dist = float('inf')

            for idx, det in enumerate(unmatched_detections):
                dx, dy, dw, dh = det
                dcx, dcy = dx + dw / 2.0, dy + dh / 2.0
                dist = np.hypot(tcx - dcx, tcy - dcy)

                if dist < best_dist and dist < self.match_dist:
                    best_dist = dist
                    best_idx = idx

            if best_idx != -1:
                # Smooth update towards matched detection
                det = unmatched_detections.pop(best_idx)
                new_box = [trk['box'][i] * 0.6 + det[i] * 0.4 for i in range(4)]
                updated_tracks.append({'box': new_box, 'missed': 0})
            else:
                trk['missed'] += 1
                if trk['missed'] <= self.max_missed:
                    updated_tracks.append(trk)

        # Spawn new tracks for remaining unmatched faces
        for det in unmatched_detections:
            updated_tracks.append({'box': [float(v) for v in det], 'missed': 0})

        self.tracks = updated_tracks

    def get_boxes(self):
        return [[int(round(v)) for v in trk['box']] for trk in self.tracks]


# -------------------------------------------------------------------------
# 4. Main Streaming Loop (High-Throughput & Uncapped)
# -------------------------------------------------------------------------
CAM_INDEX = 0
cap = None

try:
    cap = cv2.VideoCapture(CAM_INDEX)
    cap.set(cv2.CAP_PROP_FRAME_WIDTH, 640)
    cap.set(cv2.CAP_PROP_FRAME_HEIGHT, 480)
    cap.set(cv2.CAP_PROP_BUFFERSIZE, 1)

    if not cap.isOpened():
        raise RuntimeError(f"Cannot access camera on /dev/video{CAM_INDEX}")

    for _ in range(5):
        cap.read()

    image_widget = widgets.Image(format='jpeg', width=640, height=480)
    display(image_widget)

    tracker = MultiFaceTracker(max_missed=5, match_dist=90.0)
    t_prev = time.time()
    fps_smooth = 15.0
    alpha = 0.15
    frame_idx = 0

    print("Multi-face pipeline running. Maximum hardware throughput active.")

    while True:
        ret, frame = cap.read()
        if not ret or frame is None:
            break

        frame_idx += 1

        # Run hardware detection on even frames
        if frame_idx % 2 == 0:
            gray = cv2.cvtColor(frame, cv2.COLOR_BGR2GRAY)
            detections = detect_faces_webcam(gray, min_neighbors=2)
            tracker.update(detections)

        # Render all tracked faces independently
        active_boxes = tracker.get_boxes()
        for (bx, by, bw, bh) in active_boxes:
            cv2.rectangle(frame, (bx, by), (bx + bw, by + bh), (0, 255, 0), 2)

        # FPS & Telemetry
        t_curr = time.time()
        dt = t_curr - t_prev
        t_prev = t_curr
        if dt > 0:
            inst_fps = 1.0 / dt
            fps_smooth = alpha * inst_fps + (1.0 - alpha) * fps_smooth

        cv2.putText(frame, f"FPS: {fps_smooth:.1f} | Faces: {len(active_boxes)}",
                    (20, 35), cv2.FONT_HERSHEY_SIMPLEX, 0.8, (0, 255, 0), 2)

        # Fast JPEG encoding to widget
        _, jpeg = cv2.imencode('.jpg', frame, [cv2.IMWRITE_JPEG_QUALITY, 50])
        image_widget.value = jpeg.tobytes()

except KeyboardInterrupt:
    print("Stream stopped.")
finally:
    if cap is not None and cap.isOpened():
        cap.release()
    frame_buf.freebuffer()
    hits_buf.freebuffer()
