    "    ip.write(REG_FRAME_LO, fa & 0xFFFFFFFF); ip.write(REG_FRAME_HI, fa >> 32)\n",
    "    ip.write(REG_HITS_LO,  ha & 0xFFFFFFFF); ip.write(REG_HITS_HI,  ha >> 32)\n",
    "    ip.write(REG_WIDTH,  w)\n",
    "    ip.write(REG_HEIGHT, h)\n",
    "\n",
    "    ip.write(REG_CTRL, 0x1)                      # ap_start\n",
    "    t0 = time.time()\n",
