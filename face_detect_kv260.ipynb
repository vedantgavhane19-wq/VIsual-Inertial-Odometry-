import time
import cv2
import numpy as np
import ipywidgets as widgets
from IPython.display import display
from pynq import MMIO, Overlay, allocate

# -------------------------------------------------------------------------
# 1. Hardware, Overlay & Memory Allocations
# -------------------------------------------------------------------------
BIT_FILE  = "face_detect.bit"
CTRL_BASE = 0xA0000000

MAX_W, MAX_H, MAX_HITS = 320, 240, 4096
WIN = 24

REG_CTRL                   = 0x00
REG_RET                    = 0x10
REG_FRAME_LO, REG_FRAME_HI = 0x18, 0x1C
REG_HITS_LO,  REG_HITS_HI  = 0x24, 0x28
REG_WIDTH,    REG_HEIGHT   = 0x30, 0x38

# Load bitstream and map registers
ol = Overlay(BIT_FILE)
ip = MMIO(CTRL_BASE, 0x10000)

# Allocate physically contiguous DMA buffers
frame_buf = allocate(shape=(MAX_W * MAX_H,), dtype=np.uint8)
hits_buf  = allocate(shape=(MAX_HITS,),       dtype=np.uint32)

# -------------------------------------------------------------------------
# 2. Hardware Driver & Clustering Helpers
# -------------------------------------------------------------------------
def run_kernel(img, timeout_s=1.5):
    h, w = img.shape
    if not img.flags['C_CONTIGUOUS']:
        img = np.ascontiguousarray(img)

    frame_buf[: w * h] = img.ravel()
    frame_buf.sync_to_device()

    fa = int(frame_buf.device_address)
    ha = int(hits_buf.device_address)
    ip.write(REG_FRAME_LO, fa & 0xFFFFFFFF)
    ip.write(REG_FRAME_HI, (fa >> 32) & 0xFFFFFFFF)
    ip.write(REG_HITS_LO,  ha & 0xFFFFFFFF)
    ip.write(REG_HITS_HI,  (ha >> 32) & 0xFFFFFFFF)
    ip.write(REG_WIDTH,    w)
    ip.write(REG_HEIGHT,   h)

    # Start accelerator (ap_start = bit 0)
    ip.write(REG_CTRL, 0x1)

    # Poll ap_done (bit 1)
    t0 = time.time()
    while not (ip.read(REG_CTRL) & 0x2):
        if time.time() - t0 > timeout_s:
            return np.array([], dtype=int), np.array([], dtype=int), 0

    n = ip.read(REG_RET)
    hits_buf.sync_from_device()

    k = min(n, MAX_HITS)
    if k == 0:
        return np.array([], dtype=int), np.array([], dtype=int), 0

    v = np.array(hits_buf[:k], dtype=np.uint32)
    return (v & 0xFFFF).astype(int), (v >> 16).astype(int), n


def group_rects(boxes, min_neighbors=3, eps=0.25):
    n = len(boxes)
    if n == 0:
        return []
    parent = list(range(n))

    def find(i):
        while parent[i] != i:
            parent[i] = parent[parent[i]]
            i = parent[i]
        return i

    def similar(a, b):
        d = eps * (min(a[2], b[2]) + min(a[3], b[3])) * 0.5
        return (abs(a[0] - b[0]) <= d and abs(a[1] - b[1]) <= d
                and abs(a[0] + a[2] - b[0] - b[2]) <= d
                and abs(a[1] + a[3] - b[1] - b[3]) <= d)

    for i in range(n):
        for j in range(i + 1, n):
            if similar(boxes[i], boxes[j]):
                parent[find(i)] = find(j)

    clusters = {}
    for i in range(n):
        clusters.setdefault(find(i), []).append(boxes[i])

    out = []
    for members in clusters.values():
        if len(members) >= min_neighbors:
            m = np.mean(np.array(members, dtype=np.float64), axis=0)
            out.append(tuple(int(round(x)) for x in m))
    return out


def detect_faces(gray_frame, scale=1.2, min_neighbors=3, min_size=40):
    base = cv2.resize(gray_frame, (MAX_W, MAX_H), interpolation=cv2.INTER_LINEAR)
    boxes = []
    s = 1.0

    # 4 pyramid levels covering face sizes cleanly without gaps
    for _ in range(4):
        nw = int(round(MAX_W / s))
        nh = int(round(MAX_H / s))
        if nw < WIN or nh < WIN:
            break

        lvl = cv2.resize(base, (nw, nh), interpolation=cv2.INTER_NEAREST)
        xs, ys, n = run_kernel(lvl)

        scale_factor = (640.0 / MAX_W) * s
        for x, y in zip(xs, ys):
            boxes.append([
                int(x * scale_factor),
                int(y * scale_factor),
                int(WIN * scale_factor),
                int(WIN * scale_factor)
            ])
        s *= scale

    return [b for b in group_rects(boxes, min_neighbors=min_neighbors) if b[2] >= min_size]

# -------------------------------------------------------------------------
# 3. Live Webcam Stream Loop (Flicker-Free ipywidgets)
# -------------------------------------------------------------------------
CAM_INDEX = 0
cap = None

try:
    cap = cv2.VideoCapture(CAM_INDEX)
    cap.set(cv2.CAP_PROP_FRAME_WIDTH, 640)
    cap.set(cv2.CAP_PROP_FRAME_HEIGHT, 480)
    cap.set(cv2.CAP_PROP_BUFFERSIZE, 1)

    if not cap.isOpened():
        raise RuntimeError(f"Cannot access camera on /dev/video{CAM_INDEX}")

    for _ in range(5):
        cap.read()

    # Native widget image: updates bytes in memory without browser DOM reflow
    image_widget = widgets.Image(format='jpeg', width=640, height=480)
    display(image_widget)

    TARGET_FPS = 15.0
    FRAME_BUDGET = 1.0 / TARGET_FPS

    t_prev = time.time()
    fps_smooth = TARGET_FPS
    alpha = 0.15
    frame_idx = 0
    active_faces = []
    smoothed_box = None
    missed_count = 0

    print("Stream running locked at 15 FPS. Press Stop/Interrupt to exit.")

    while True:
        t_frame_start = time.time()

        ret, frame = cap.read()
        if not ret or frame is None:
            break

        frame_idx += 1

        # Run detection on even frames; hold and smooth on odd frames
        if frame_idx % 2 == 0 or len(active_faces) == 0:
            gray = cv2.cvtColor(frame, cv2.COLOR_BGR2GRAY)
            detected = detect_faces(gray, scale=1.2, min_neighbors=3, min_size=40)
            
            if len(detected) > 0:
                active_faces = detected
                missed_count = 0
            else:
                missed_count += 1
                # Prevent face dropouts: hold box across momentary missed frames
                if missed_count > 4:
                    active_faces = []
                    smoothed_box = None

        # Position smoothing: glides smoothly without jumping
        if len(active_faces) > 0:
            target = active_faces[0]
            if smoothed_box is None:
                smoothed_box = list(target)
            else:
                for i in range(4):
                    smoothed_box[i] = smoothed_box[i] * 0.7 + target[i] * 0.3

            bx, by, bw, bh = [int(round(v)) for v in smoothed_box]
            cv2.rectangle(frame, (bx, by), (bx + bw, by + bh), (0, 255, 0), 2)

        # FPS overlay
        cv2.putText(frame, f"FPS: {fps_smooth:.1f} | Faces: {len(active_faces)}",
                    (20, 35), cv2.FONT_HERSHEY_SIMPLEX, 0.8, (0, 255, 0), 2)

        # Update widget byte buffer directly
        _, jpeg = cv2.imencode('.jpg', frame, [cv2.IMWRITE_JPEG_QUALITY, 65])
        image_widget.value = jpeg.tobytes()

        # Frame pacing
        elapsed = time.time() - t_frame_start
        sleep_needed = FRAME_BUDGET - elapsed
        if sleep_needed > 0:
            time.sleep(sleep_needed)

        t_curr = time.time()
        dt = t_curr - t_prev
        t_prev = t_curr
        if dt > 0:
            inst_fps = 1.0 / dt
            fps_smooth = alpha * inst_fps + (1.0 - alpha) * fps_smooth

except KeyboardInterrupt:
    print("Stream stopped.")
finally:
    if cap is not None and cap.isOpened():
        cap.release()
    frame_buf.freebuffer()
    hits_buf.freebuffer()
